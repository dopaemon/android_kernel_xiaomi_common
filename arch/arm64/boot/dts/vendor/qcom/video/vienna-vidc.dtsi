&soc {
	msm_vidc: qcom,vidc@aa00000 {
		compatible = "qcom,msm-vidc","qcom,msm-vidc-vienna", "qcom,msm-vidc-ar50lt";
		status = "okay";
		reg = <0xaa00000 0x200000>;
		interrupts = <GIC_SPI 220 IRQ_TYPE_LEVEL_HIGH>;

		memory-region = <&video_mem>;
		pas-id = <9>;

		/* IOMMU Config */
		#address-cells = <1>;
		#size-cells = <1>;

		/* Supply */
		venus-supply = <&gcc_venus_gdsc>;
		venus-core0-supply = <&gcc_vcodec0_gdsc>;

		/* Clocks */
		clock-names = "core_clk", "bus_clk",
			"core0_clk", "core0_bus_clk";

		clock-ids = <GCC_VIDEO_VENUS_CTL_CLK
			GCC_VENUS_CTL_AXI_CLK GCC_VIDEO_VCODEC0_SYS_CLK
			GCC_VCODEC0_AXI_CLK>;
		clocks = <&gcc GCC_VIDEO_VENUS_CTL_CLK>,
			<&gcc GCC_VENUS_CTL_AXI_CLK>,
			<&gcc GCC_VIDEO_VCODEC0_SYS_CLK>,
			<&gcc GCC_VCODEC0_AXI_CLK>;
		qcom,proxy-clock-names = "core_clk", "bus_clk",
			"core0_clk", "core0_bus_clk";
		qcom,clock-configs = <0x1 0x0 0x1 0x0>;
		qcom,allowed-clock-rates = <95000000 133333333 270000000 365000000
			384000000>;

		qcom,reg-presets = <0xB0080 0x0 0x03>;
		/* Video Firmware ELF image name */
		vidc,firmware-name = "venus_v7_3";
		/* Bus Interconnects */
		interconnect-names = "venus-cnoc", "venus-ddr";
		interconnects = <&gem_noc   MASTER_APPSS_PROC
					&config_noc SLAVE_VENUS_CFG>,
				<&mmss_noc MASTER_VIDEO
					&mc_virt   SLAVE_EBI1>;
		/* Bus BW range (low, high) for each bus */
		qcom,bus-range-kbps = <1000 1000
					1000 6500000>;

		/* MMUs */
		iommu_region_partition: iommu_region_partition {
			/* These IOVA regions are unique per context bank */
			iommu-addresses = <&non_secure_cb 0x0 0x70800000>,
						<&non_secure_cb 0xe0000000 0x20000000>,
				<&secure_bitstream_cb 0x0 0x4b000000>,
						<&secure_bitstream_cb 0x70800000 0x8f800000>,
				<&secure_pixel_cb 0x0 0x25800000>,
						<&secure_pixel_cb 0x4b000000 0xb5000000>,
				<&secure_non_pixel_cb 0x0 0x1000000>,
						<&secure_non_pixel_cb 0x25800000 0xda800000>;
		};

		non_secure_cb:non_secure_cb {
			compatible = "qcom,msm-vidc,context-bank";
			label = "venus_ns";
			iommus =
				<&apps_smmu 0x980 0x20>;
			memory-region = <&iommu_region_partition>;
			qcom,iommu-faults = "non-fatal";
			virtual-addr-pool = <0x70800000 0x6f800000>;
			qcom,iova-best-fit;
			/* log2 of desired alignment (1MB) - log2 of PAGE_SIZE; (20 - 12 = 8) */
			qcom,iova-max-align-shift = <8>; /* 1 MB */
			dma-coherent;
		};

		secure_bitstream_cb:secure_bitstream_cb {
			compatible = "qcom,msm-vidc,context-bank";
			label = "venus_sec_bitstream";
			iommus =
				<&apps_smmu 0x981 0x04>;
			memory-region = <&iommu_region_partition>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-vmid = <0x9>; /*VMID_CP_BITSTREAM*/
			virtual-addr-pool = <0x4b000000 0x25800000>;
			qcom,iova-best-fit;
			qcom,iova-max-align-shift = <8>; /* 1 MB */
			qcom,secure-context-bank;
		};

		secure_pixel_cb:secure_pixel_cb {
			compatible = "qcom,msm-vidc,context-bank";
			label = "venus_sec_pixel";
			iommus =
				<&apps_smmu 0x983 0x0>;
			memory-region = <&iommu_region_partition>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-vmid = <0xA>; /*VMID_CP_PIXEL*/
			virtual-addr-pool = <0x25800000 0x25800000>;
			qcom,iova-best-fit;
			qcom,iova-max-align-shift = <8>; /* 1 MB */
			qcom,secure-context-bank;
		};

		secure_non_pixel_cb:secure_non_pixel_cb {
			compatible = "qcom,msm-vidc,context-bank";
			label = "venus_sec_non_pixel";
			iommus =
				<&apps_smmu 0x984 0x20>;
			memory-region = <&iommu_region_partition>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-vmid = <0xB>; /*VMID_CP_NON_PIXEL*/
			virtual-addr-pool = <0x01000000 0x24800000>;
			qcom,iova-best-fit;
			qcom,iova-max-align-shift = <8>; /* 1 MB */
			qcom,secure-context-bank;
		};
	};
};
